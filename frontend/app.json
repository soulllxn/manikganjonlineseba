{
  "expo": {
    "name": "মানিকগঞ্জ অনলাইন সেবা",
    "slug": "manikganj-online-seba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manikganj",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shoriful.manikganjonlineseba",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shoriful.manikganjonlineseba",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#006A4E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["CALL_PHONE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#006A4E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
